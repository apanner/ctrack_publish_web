# Copy to .env and fill in deploy keys (gitignored)

# --- Supabase (web + deploy) ---
VITE_SUPABASE_URL=https://czwfeqheduofviockrab.supabase.co
VITE_SUPABASE_ANON_KEY=

# Deploy only — personal access token (NOT service role)
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Deploy / release publish (also loaded from ../ctrack_v0/.env.local if omitted here)
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub Releases (installer hosting — primary) ---
# Fine-grained or classic PAT with repo / contents:read (private repos) or contents:write (local publish)
# GitHub Actions uses built-in GITHUB_TOKEN; this is for local scripts + Supabase engine-download edge.
# https://github.com/settings/tokens
GITHUB_RELEASE_TOKEN=
# Optional — auto-detected via `gh repo view` when unset
# GITHUB_REPOSITORY=apanner/ctrack_publish_web

# --- AWS (legacy installer releases on S3 only — optional) ---
# Still used for facility publish uploads (engine hybrid storage), not installer releases.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=ctrack-storage

# Scripts map AWS_S3_BUCKET_NAME → AWS_S3_BUCKET automatically
