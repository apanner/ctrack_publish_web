# Same as ctrack_publish desktop — engine reads from engine/.env or %USERPROFILE%\.ctrack-engine\.env
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_PROVIDER=hybrid
# MinIO primary (local / Tailscale). Required when STORAGE_PROVIDER=hybrid.
HYBRID_STORAGE_PRIMARY_ENDPOINT=http://100.92.38.79:9000
HYBRID_STORAGE_PRIMARY_BUCKET=ctrack
HYBRID_STORAGE_PRIMARY_ACCESS_KEY=
# S3 API secret (Identity → Access Keys). Not the MinIO Console login password.
HYBRID_STORAGE_PRIMARY_SECRET_KEY=
HYBRID_STORAGE_PRIMARY_REGION=us-east-1
# Test: npm run test:storage  or  GET http://127.0.0.1:7777/api/storage/test

CTRACK_ENGINE_PORT=7777
CTRACK_ENGINE_HOST=127.0.0.1
CTRACK_WEB_ORIGINS=https://ctrackpublishweb.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CTRACK_WEB_URL=https://ctrackpublishweb.vercel.app
# Optional override; defaults to SUPABASE_URL/functions/v1
# CTRACK_EDGE_BASE=https://czwfeqheduofviockrab.supabase.co/functions/v1
CTRACK_UPDATE_CHANNEL=stable
# Public metadata manifest for tray auto-update (no exe URLs inside)
# CTRACK_MANIFEST_URL=https://<bucket>.s3.<region>.amazonaws.com/ctrack-downloads/channels/stable/latest.json
SUPABASE_URL=

# OpenEXR sequence → MP4: zscale preset (FFmpeg with libzimg). rec709_linear | rec2020_linear | wide_linear | none
CTRACK_EXR_COLORSPACE=rec709_linear

# Optional: OCIO display LUT for EXR → MP4 review look (preferred for Nuke parity).
# If set and file exists, engine uses ffmpeg lut3d before fallback zscale.
# Example (from Nuke/OCIO baked display LUT): D:\show\color\review_display_srgb.cube
CTRACK_OCIO_LUT_PATH=

# EXR review via bundled oiiotool (run engine/python/scripts/setup_oiio.py once).
# Uses Nuke aces_1.2 OCIO when copied to engine/runtime/ocio/aces_1.2
CTRACK_OCIO_CONFIG=
# EXR review: auto (nuke → oiio → ffmpeg) | nuke | oiio | ffmpeg
CTRACK_TRANSCODE_MODE=auto
# Relative to engine root after ensure-engine-runtime:
# CTRACK_OCIO_CONFIG=runtime/ocio/aces_1.2/config.ocio
