# Vercel only builds web/ — exclude repo-root engine, Nuke plugin, installers, scripts
# Use leading "/" so patterns do NOT match web/src/components/engine/
/engine/
/ctrack_nuke/
/release/
/installer/
/scripts/
/packages/
/supabase/
.cache/
.turbo/
coverage/
**/__pycache__/
**/*.pyc
**/.venv/
**/*.exe
**/*.zip
**/*.7z

# Dependencies and build outputs (rebuilt on Vercel)
**/node_modules/
/web/dist/
/engine/dist/
/engine/dist-bundle/
/engine/runtime/

# Local secrets
.env
.env.*
!.env.example
!**/.env.example
