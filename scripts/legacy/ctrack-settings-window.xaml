<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CTrack Publish Engine"
        Width="960" Height="720"
        MinWidth="880" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#0B1118"
        FontFamily="Segoe UI, Segoe UI Variable"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        x:Name="RootWindow">

  <Window.Resources>
    <SolidColorBrush x:Key="TextBrush" Color="#E8EEF5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8FA0B3"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#24E1B1"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#101820"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2A3848"/>
    <SolidColorBrush x:Key="RowBrush" Color="#151D28"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#121820"/>

    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#B8C5D3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="10,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#182230"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
      <Setter Property="Foreground" Value="#24E1B1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Margin="10,2">
              <Border x:Name="Bd" Background="#152028" CornerRadius="8" BorderBrush="#24E1B1" BorderThickness="1" Padding="14,11">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
              </Border>
              <Border Width="3" HorizontalAlignment="Left" Margin="4,10,0,10" Background="#24E1B1" CornerRadius="2"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#151D28"/>
      <Setter Property="BorderBrush" Value="#243041"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8FA0B3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E8EEF5"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Background" Value="#101820"/>
      <Setter Property="Foreground" Value="#E8EEF5"/>
      <Setter Property="BorderBrush" Value="#2A3848"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="#24E1B1"/>
    </Style>

    <Style x:Key="Combo" TargetType="ComboBox">
      <Setter Property="Background" Value="#101820"/>
      <Setter Property="Foreground" Value="#E8EEF5"/>
      <Setter Property="BorderBrush" Value="#2A3848"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style x:Key="BtnSecondary" TargetType="Button">
      <Setter Property="Background" Value="#182230"/>
      <Setter Property="Foreground" Value="#E8EEF5"/>
      <Setter Property="BorderBrush" Value="#2A3848"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Background" Value="#24E1B1"/>
      <Setter Property="Foreground" Value="#062018"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chk" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8EEF5"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Dark ListView for tools table -->
    <Style x:Key="ToolsGridView" TargetType="{x:Type GridViewColumnHeader}">
      <Setter Property="Background" Value="#1A2533"/>
      <Setter Property="Foreground" Value="#8FA0B3"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="BorderBrush" Value="#243041"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="ToolsListViewItem" TargetType="ListViewItem">
      <Setter Property="Background" Value="#151D28"/>
      <Setter Property="Foreground" Value="#E8EEF5"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
          <Setter Property="Background" Value="#121820"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1C2836"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar: fixed 3-row grid (fixes status text bleeding into nav) -->
    <Border Grid.Column="0" Background="#0F1720" BorderBrush="#1A2533" BorderThickness="0,0,1,0">
      <Grid Margin="0,20,0,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,0,16,16">
          <Image x:Name="AppLogo" Width="44" Height="44" HorizontalAlignment="Left"/>
          <TextBlock Text="CTrack Engine" Foreground="#E8EEF5" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,2"/>
          <TextBlock Text="Publish pipeline" Foreground="#8FA0B3" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="1" x:Name="NavPanel" VerticalAlignment="Top">
          <Button x:Name="NavGeneral" Content="General" Style="{StaticResource NavBtnActive}" Tag="0"/>
          <Button x:Name="NavReview" Content="Review and MP4" Style="{StaticResource NavBtn}" Tag="1"/>
          <Button x:Name="NavNuke" Content="Nuke" Style="{StaticResource NavBtn}" Tag="2"/>
          <Button x:Name="NavTools" Content="Tools" Style="{StaticResource NavBtn}" Tag="3"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="12,12,12,0" Padding="14,12" Background="#121A24" CornerRadius="10" BorderBrush="#243041" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="StatusBackend" Text="EXR backend: --" Foreground="#24E1B1" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusNukeCount" Text="Nuke installs: 0" Foreground="#8FA0B3" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Main -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="32,28,32,12">
        <StackPanel x:Name="PagesHost" MaxWidth="640" HorizontalAlignment="Left">

          <StackPanel x:Name="PageGeneral" Visibility="Visible">
            <TextBlock Text="General" Style="{StaticResource H1}"/>
            <TextBlock Text="Connection and startup" Foreground="#8FA0B3" Margin="0,0,0,18"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Hosted web UI URL" Style="{StaticResource Lbl}"/>
                <TextBox x:Name="TxtWebUrl" Style="{StaticResource Input}"/>
                <CheckBox x:Name="ChkLogin" Content="Start engine when Windows starts" Style="{StaticResource Chk}" Margin="0,14,0,0"/>
                <CheckBox x:Name="ChkNotify" Content="Notify when tools are missing" Style="{StaticResource Chk}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Engine status" Style="{StaticResource Lbl}"/>
                <TextBlock x:Name="TxtEngineStatus" TextWrapping="Wrap" Foreground="#E8EEF5" LineHeight="22"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="BtnOpenConfig" Content="Open config folder" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                  <Button x:Name="BtnOpenSetup" Content="Open web setup" Style="{StaticResource BtnSecondary}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PageReview" Visibility="Collapsed">
            <TextBlock Text="Review and MP4" Style="{StaticResource H1}"/>
            <TextBlock Text="Transcode pipeline and output scale" Foreground="#8FA0B3" Margin="0,0,0,18"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Transcode mode" Style="{StaticResource Lbl}"/>
                <ComboBox x:Name="CmbTranscodeMode" Style="{StaticResource Combo}" Width="200" HorizontalAlignment="Left"/>
                <TextBlock Text="Fallback order (auto mode)" Style="{StaticResource Lbl}" Margin="0,14,0,6"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ListBox x:Name="LstOrder" Height="100" Background="#101820" Foreground="#E8EEF5" BorderBrush="#2A3848" BorderThickness="1"/>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BtnOrderUp" Content="Up" Style="{StaticResource BtnSecondary}" Width="68" Margin="0,0,0,6"/>
                    <Button x:Name="BtnOrderDown" Content="Down" Style="{StaticResource BtnSecondary}" Width="68"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="TxtActiveBackend" Foreground="#8FA0B3" Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="MP4 review scale" Foreground="#E8EEF5" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Nuke Reformat, OIIO fit, FFmpeg scale" Foreground="#8FA0B3" Margin="0,0,0,12"/>
                <TextBlock Text="Preset" Style="{StaticResource Lbl}"/>
                <ComboBox x:Name="CmbMp4Preset" Style="{StaticResource Combo}" Width="260" HorizontalAlignment="Left"/>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Width (px)" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtMp4Width" Style="{StaticResource Input}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Height (px)" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="TxtMp4Height" Style="{StaticResource Input}"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="TxtMp4Hint" Foreground="#8FA0B3" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PageNuke" Visibility="Collapsed">
            <TextBlock Text="Nuke" Style="{StaticResource H1}"/>
            <TextBlock Text="Batch render for OCIO-accurate review MP4" Foreground="#8FA0B3" Margin="0,0,0,18"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Preferred Nuke executable" Style="{StaticResource Lbl}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="CmbNuke" Style="{StaticResource Combo}"/>
                  <Button x:Name="BtnBrowseNuke" Grid.Column="1" Content="Browse" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" MinWidth="80"/>
                </Grid>
                <CheckBox x:Name="ChkInteractive" Content="Interactive license (-i)" Style="{StaticResource Chk}" Margin="0,14,0,0"/>
                <CheckBox x:Name="ChkSafe" Content="Safe mode (--safe)" Style="{StaticResource Chk}"/>
                <TextBlock Text="Review template (.nk)" Style="{StaticResource Lbl}" Margin="0,8,0,6"/>
                <TextBox x:Name="TxtTemplate" Style="{StaticResource Input}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PageTools" Visibility="Collapsed">
            <TextBlock Text="Runtime tools" Style="{StaticResource H1}"/>
            <TextBlock Text="Bundled with the engine installer" Foreground="#8FA0B3" Margin="0,0,0,18"/>
            <Border Style="{StaticResource Card}" Padding="0">
              <ListView x:Name="ListTools" Height="280" BorderThickness="0" Background="Transparent"
                        AlternationCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                  <GridView ColumnHeaderContainerStyle="{StaticResource {x:Type GridViewColumnHeader}}">
                    <GridViewColumn Header="Tool" DisplayMemberBinding="{Binding Tool}" Width="110"/>
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="72"/>
                    <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="380"/>
                  </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem" BasedOn="{StaticResource ToolsListViewItem}"/>
                </ListView.ItemContainerStyle>
              </ListView>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button x:Name="BtnRescan" Content="Rescan tools" Style="{StaticResource BtnSecondary}" Margin="0,0,12,0"/>
              <TextBlock x:Name="TxtLastScan" VerticalAlignment="Center" Foreground="#8FA0B3" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="1" Background="#0F1720" BorderBrush="#1A2533" BorderThickness="0,1,0,0" Padding="32,14">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" x:Name="TxtFooterHint" Text="Saved to %USERPROFILE%\.ctrack-engine\" Foreground="#8FA0B3" VerticalAlignment="Center"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" MinWidth="92"/>
            <Button x:Name="BtnSave" Content="Save" Style="{StaticResource BtnPrimary}" MinWidth="108"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
